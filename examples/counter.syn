&io;
// Classes hold state; an instance method is called as a bare `NAME(...)`,
// which dispatches to the current instance. The old `self.NAME(...)` form is
// retired.
// 类持有状态；实例方法以裸 `NAME(...)` 调用，即派发到当前实例。旧的
// `self.NAME(...)` 形式已退役。
$Program {
    @::[{
        -(Counter c);
        c.inc();
        c.inc();
        c.inc();

        io::out.push_line(c.get());              // → 3
        io::out.push_line(c.describe());         // → Counter(value=3)
    }];
};

$Counter {
    -(std::Number value);

    @get[() ~> (result) {
        result << value;
    }];

    @inc[() -> () {
        // Instance methods call each other directly by bare name.
        // 实例方法之间以裸名互相调用。
        value << next_value();
    }];

    @next_value[() ~> (result[std::Number]) {
        result << value.+(1);
    }];

    // `<<` REBINDS a variable, it does not append — string building is done
    // with `+` (and `to_string` to stringify a Number).
    // `<<` 是重新绑定变量而非追加——拼字符串要用 `+`（数字先 `to_string`）。
    @describe[() ~> (text[std::String]) {
        text << "Counter(value=".+(value.to_string()).+(")");
    }];
};
