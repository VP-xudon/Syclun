// lib/maths.synl
//
// Standard library: maths (Synth-OOP interface).
// 标准库：maths（Synth-OOP 接口）。
//
// Human-readable face of the maths library. Methods are given as signatures
// only; their behavior is supplied by the C++ backend in lib/cpp/maths.hpp.
// On `&maths;` the interpreter brings the native class online first, then
// interprets this file; the class is already registered, so its definition
// here is treated purely as documentation of the public shape. The `$Program`
// class, should one appear, is ignored in a library.
// maths 库面向人类的形态。方法仅以签名给出，真实行为由 lib/cpp/maths.hpp
// 的 C++ 底层提供。程序写 `&maths;` 时，解释器先上线原生类，再解释本文件；
// 该类已登记，此处定义仅作公开形态文档。库中出现 `$Program` 时忽略。
//
// Method signatures below carry their type constraints; the interpreter
// enforces them at the call boundary (a wrong-typed argument yields a
// "Argument type mismatch" poison instead of failing deep inside the C++ body).
// The authoritative enforced signature lives in lib/cpp/maths.hpp's make_sign;
// this file mirrors it for documentation / IDE / consistency.
// 下列方法签名均带类型约束；解释器在调用边界强制检查（类型不符的实参会
// 产生 "Argument type mismatch" 毒水，而非在 C++ 方法体深处崩溃）。强制检查
// 的权威签名位于 lib/cpp/maths.hpp 的 make_sign；本文件是其可读镜像。

$Maths {
    @abs   << [(x[std::Number]) ~> (r[std::Number]) { }];
    @sqrt  << [(x[std::Number]) ~> (r[std::Number]) { }];
    @pow   << [(base[std::Number], exp[std::Number]) ~> (r[std::Number]) { }];
    @floor << [(x[std::Number]) ~> (r[std::Number]) { }];
    @ceil  << [(x[std::Number]) ~> (r[std::Number]) { }];
    @round << [(x[std::Number]) ~> (r[std::Number]) { }];
    @sin   << [(x[std::Number]) ~> (r[std::Number]) { }];
    @cos   << [(x[std::Number]) ~> (r[std::Number]) { }];
    @tan   << [(x[std::Number]) ~> (r[std::Number]) { }];
    @log   << [(x[std::Number]) ~> (r[std::Number]) { }];
    @log10 << [(x[std::Number]) ~> (r[std::Number]) { }];
    @exp   << [(x[std::Number]) ~> (r[std::Number]) { }];
    @mod   << [(a[std::Number], b[std::Number]) ~> (r[std::Number]) { }];
    @min   << [(a[std::Number], b[std::Number]) ~> (r[std::Number]) { }];
    @max   << [(a[std::Number], b[std::Number]) ~> (r[std::Number]) { }];
    @pi    << [() ~> (r[std::Number]) { }];
    @e     << [() ~> (r[std::Number]) { }];
    @random << [() ~> (r[std::Number]) { }];
}

// ------------------------------------------------------------
// v1.30 preset object / v1.30 预置对象
//
// One ready-made object comes with the import, named inside the library's
// own namespace (`maths::math`) — instantiating `$Maths` yourself is
// unnecessary ceremony when the class is stateless. It is a const binding:
// the name always refers to the same object.
// 导入即附带一个成品对象，以库自己的命名空间为名（`maths::math`）——
// 无状态的类再自行实例化纯属仪式。它是常数绑定：名字永远指向同一对象。
// ------------------------------------------------------------
-(maths::Maths! maths::math);
