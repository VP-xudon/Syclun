// lib/re.synl
//
// Standard library: re (Synth-OOP interface).
// 标准库：re（Synth-OOP 接口）。
//
// The behavioral face of the `re` (regular-expression) library. The C++
// backend in lib/re.hpp does the matching with its OWN linear-time Pike VM
// (a Thompson NFA compiled to byte-code), which is immune to catastrophic
// backtracking (ReDoS) — a bounded step counter adds a final safety ceiling.
// `re` exposes static convenience methods that compile a pattern on the fly;
// `Pattern` is a precompiled, reusable matcher; `Match` is a result object.
// A `$Program` class in a library is ignored.
// `re`（正则）库的行为形态，真实匹配由 lib/re.hpp 的内置线性时间 Pike 虚拟机
// （Thompson NFA 编译为字节码）完成，对灾难性回溯（ReDoS）免疫；有界步数计数器
// 再加最后一道安全上限。`re` 提供即时编译的静态便捷方法；`Pattern` 为预编译可复用
// 匹配器；`Match` 为结果对象。库中 `$Program` 被忽略。
//
// Method signatures below carry their type constraints; the interpreter
// enforces them at the call boundary (a wrong-typed argument yields a
// "Argument type mismatch" poison instead of failing deep inside the C++ body).
// 下列方法签名均带类型约束；解释器在调用边界强制检查（类型不符的实参会
// 产生 "Argument type mismatch" 毒水，而非在 C++ 方法体深处崩溃）。

$Re {
    // Compile a pattern source string into a reusable Pattern. An optional flags
    // string ("i" case-insensitive, "m" multiline, "s" dotall) may be passed.
    // 把模式源字符串编译为可复用的 Pattern。可传入可选 flags 串
    // （"i" 忽略大小写、"m" 多行、"s" 点匹配换行）。
    @compile[(pattern[std::String], flags[std::String]) ~> (pat[re::Pattern]) { }];
    @escape[(s[std::String]) ~> (out[std::String]) { }];
    @match[(pattern[std::String], text[std::String], flags[std::String]) ~> (result[re::Match]) { }];
    @search[(pattern[std::String], text[std::String], flags[std::String]) ~> (result[re::Match]) { }];
    @findall[(pattern[std::String], text[std::String], flags[std::String]) ~> (arr[std::Array]) { }];
    @replace[(pattern[std::String], text[std::String], repl[std::String], flags[std::String]) ~> (out[std::String]) { }];
    @replace_fn[(pattern[std::String], text[std::String], callback[behavior], flags[std::String]) ~> (out[std::String]) { }];
    @split[(pattern[std::String], text[std::String], flags[std::String]) ~> (arr[std::Array]) { }];
    @test[(pattern[std::String], text[std::String], flags[std::String]) ~> (ok[std::Boolean]) { }];
}

$Pattern {
    // Match against an already-compiled pattern.
    // 用已编译的 Pattern 做匹配。
    @match[(text[std::String]) ~> (result[re::Match]) { }];
    @search[(text[std::String]) ~> (result[re::Match]) { }];
    @findall[(text[std::String]) ~> (arr[std::Array]) { }];
    @replace[(text[std::String], repl[std::String]) ~> (out[std::String]) { }];
    @replace_fn[(text[std::String], callback[behavior]) ~> (out[std::String]) { }];
    @split[(text[std::String]) ~> (arr[std::Array]) { }];
    @test[(text[std::String]) ~> (ok[std::Boolean]) { }];
    // Reclaim the compiled pattern state immediately. / 立即回收已编译模式状态。
    @dispose[() ~> () { }];
}

$Match {
    // matched: Boolean, text: String, groups: Array of String,
    // start/end: Number (byte offsets),
    // char_start/char_end: Number (UTF-8 code-point offsets, parallel to start/end).
    // matched：Boolean，text：String，groups：String 数组，
    // start/end：Number（字节偏移），char_start/char_end：Number（UTF-8 码点偏移，与 start/end 平行）。
}

// ------------------------------------------------------------
// v1.30 preset object / v1.30 预置对象
//
// One ready-made entry point comes with the import. Declared in THIS file, so it
// uses the BARE name `Re`; the `re::` package index is added centrally by the
// `&re;` import, so external code calls it as `re::Re` — stateless convenience
// methods (match/search/findall/replace/split/test/escape/compile) are called on
// it directly, e.g. `re::Re.search(pattern, text, flags)`. For a reusable matcher,
// call `re::Re.compile(...)` which returns a `re::Pattern`. The `::`-prefixed part
// is a package locator, not part of the name.
// 导入即附带一个成品入口。因声明在本文件内，使用裸名 `Re`；`re::` 包索引由 `&re;`
// 导入集中添加，故外部以 `re::Re` 调用——无状态便捷方法（match/search/findall/
// replace/split/test/escape/compile）直接在其上调用，如
// `re::Re.search(pattern, text, flags)`。要复用匹配器，调用 `re::Re.compile(...)`
// 返回 `re::Pattern`。`::` 前缀是包定位符，而非名字的一部分。
// ------------------------------------------------------------
-(re::Re! re::Re);
