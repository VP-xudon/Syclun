// examples/demo.syn
// A showcase of Synth-OOP syntax, exercising every highlightable construct.
// 语法高亮演示：覆盖所有可被着色的语法元素。

&io;          // module import / 模块导入
&maths;
&structs;
&assert;       // assert standard library: runtime-state inspector / 运行期状态检查器

// ---- Class declaration (with parent) / 类声明（含父类）----
// Minimal parent so the "extends" showcase resolves.
// 最小父类，使"继承"展示可解析。
$Animal {
    @!::[() ~> () {}];    // constructor / 构造
    @~[() ~> () {}];     // destructor / 析构
    @=:[() ~> (out) {}];      // publication / 公布
    @:=[(v) -> () {}];    // reception / 接收
}

$Dog [Animal] {
    // Mutable, because @inc writes it below. A '!' here would make it a const
    // member (unmodifiable); const locals still showcase '!' at line 57.
    // 可变，因为下方 @inc 要写它。此处加 '!' 会使其成为常数成员（不可修改）；
    // '!' 标记仍由第 57 行的常数局部展示。
    -(std::Number age);            // member (mutable; written by @inc)
    @get[() ~> (result) {     // constant pattern ~>
        result << age;
    }];
    @inc[() -> () {       // non-constant pattern ->
        age << age.+(1);
    }];
    @!::[() ~> () {}];    // const constructor (reserved method)
    @~[() ~> () {}];     // destructor
    @=:[() ~> (out) {}];      // publication function
    @:=[(v) -> () {}];    // reception function
}

// ---- Constraint declaration (with parent) / 约束声明（含父约束）----
// A contract body holds signatures only (no method body).
// 约束体内只写签名（不带方法体）。
#Addable {
    @+[(other) -> (result)];
}
#Comparable [Addable] {
    @<[(other) -> (result)];
}

$Program {
    @::[() -> () {
        -(io::OStream out);

        // instantiation expression / 实例化表达式
        -(std::Number a) << 10;
        -(std::Number b) << 20.5;

        // identifiers may contain digits (e.g. sha2a3 / hashValue42) / 标识符可含数字
        -(std::Number sha2a3) << 7;
        -(std::String hashValue42) << "ok";
        // value-first declaration (value followed by the variable name) /
        // 值优先声明（值后跟变量名）
        -(std::Number(1) frozen);

        // stream assignment & operators (all are method calls) / 流赋值与方法调用
        out << "sum = ";
        out << a.+(b);
        out << (std::if([() ~> (c) { c << a.>(b); }])   // control-flow object std::if
                    .then([() ~> (value) { value << a; }])
                    .else([() ~> (value) { value << b; }])
                    .value());

        // behavior literal with zero-side-effect pattern (=>), shown as a
        // method body and invoked normally. / 零副作用行为字面量（=>），
        // 以方法体形式呈现并正常调用。
        -(Calc calc);
        -(std::Number r) << calc.add3(a);

        // tuple literal + structural decomposition / 元组字面量与解构
        -(std::Tuple pair) << (100, 200);
        -(std::Number first, _) << pair;

        // std::repeat runs the body N times; each iteration's body output is
        // threaded straight through as the next .value(). A closure-captured
        // accumulator demonstrates the run — the interpreter preserves the
        // scalar type a universal `std::Object` carries (root fix for
        // type-tag degradation), so arithmetic on the threaded output works
        // directly.
        // std::repeat 把 body 跑 N 次；每轮 body 的输出即下一轮的 .value()。
        // 用闭包捕获的累加器演示运行——解释器保留通用 std::Object 所携带的
        // 标量类型（类型标签退化的根源修复），对穿线输出直接做运算即可。
        -(std::Number n) << (std::repeat(std::Number(5))
                                .then([() -> (nx) { n << n.+(1); nx << n; }])
                                .value());
        out << "repeat result = "; out << n; out << "\n";

        // constraint used as a parameter qualifier / 约束作参数限定
        // [(h[@(x)->(y)]) -> () {}]

        // IEEE-754 floating point — division by zero yields inspectable
        // non-finite results (Infinity / -Infinity / NaN), never poison.
        // IEEE-754 浮点——除以零得到可检查的非有限结果（Infinity/-Infinity/NaN），而非毒水。
        -(std::Number one)  << 1;
        -(std::Number zero) << 0;
        -(std::Number neg)  << one.-(2);              // -1 (1 - 2)
        out << " 1 / 0 = "; out << one./(zero);     out << "\n";
        out << "-1 / 0 = "; out << neg./(zero);     out << "\n";
        out << " 0 / 0 = "; out << zero./(zero);    out << "\n";

        // assert standard library — interpret / inspect runtime state.
        // assert 标准库——解读 / 检查运行期状态。
        -(assert::Checker chk);
        -(Counter c);
        out << "has_method(inc)="; out << chk.has_method(c, "inc"); out << "\n";
        out << "has_changed=";     out << chk.has_changed(c);       out << "\n";
        c:@inc[()->() { value << value.+(100); }];   // runtime rebind
        out << "has_method(inc)="; out << chk.has_method(c, "inc"); out << "\n";
        out << "has_changed=";     out << chk.has_changed(c);       out << "\n";

        // boolean literal / 布尔字面量
        -(std::Boolean ok) << true;
    }];
}

// A small class used by the assert::Checker showcase above.
// assert::Checker 演示所用的最小类。
$Counter {
    -(std::Number value);
    @get[() ~> (result) {
        result << value;
    }];
    @inc[() -> () {
        value << value.+(1);
    }];
}

// A small class used by the zero-side-effect behavior showcase above.
// 零副作用行为演示所用的最小类。
$Calc {
    @add3[(x) => (sum) { sum << x.+(3); }];   // => : zero-side-effect pattern
}
