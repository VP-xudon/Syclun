// verify/philosophy/type_preservation_demo.syn
// Root-fix demonstration + obscure-syntax stress test.
// 根源修复演示 + 生僻语法压力测试。
&io;
&maths;
&structs;
&assert;

$Program {
    @::[() -> () {
        -(io::OStream out);

        // ---- 1. Universal receiver delegates method dispatch ----
        // 1. 通用接收方（万物之源）委托方法派发
        -(std::Object x) << 10;
        out << "1. x.+(1) = "; out << x.+(1); out << "\n";          // 11
        out << "2. 1.+(x)  = "; out << 1.+(x); out << "\n";         // 11 (param-as-arg)

        // String held in an untyped variable — concatenation by delegation.
        // 无类型变量持有的字符串——经委托做拼接。
        -(std::Object s) << "hi";
        out << "3. s.+(\"!\") = "; out << s.+("!"); out << "\n";    // hi!

        // Boolean held in an untyped variable — control flow by delegation.
        // 无类型变量持有的布尔——经委托走控制流。
        -(std::Object t) << true;
        out << "4. std::if   = ";
        std::if([()->(Boolean){ Boolean << t; }])
            .then([{ out << "Y"; }])
            .else([{ out << "N"; }]);
        out << "\n";

        // ---- 2. Closure-captured loop state keeps its type (std::repeat) ----
        // 2. 闭包捕获的循环状态保留类型（std::repeat）
        -(std::Number n) << std::Number(0);
        std::repeat(std::Number(5)).then([{ n << n.+(std::Number(1)); }]);
        out << "5. std::repeat = "; out << n; out << "\n";          // 5

        // ---- 3. Closure-captured loop state + compare (std::while) ----
        // 3. 闭包捕获的循环状态 + 比较（std::while）
        -(std::Number m) << std::Number(0);
        std::while([()->(Boolean){ Boolean << m.<(std::Number(4)); }])
            .then([{ m << m.+(std::Number(1)); }]);
        out << "6. std::while   = "; out << m; out << "\n";         // 4

        // ---- 4. Direct param-as-arg on a degraded captured value ----
        // 4. 对退化捕获值直接作实参
        -(std::Number acc) << 0;
        std::repeat(std::Number(5)).then([{ acc << acc.+(std::Number(1)); }]);
        out << "7. 1.+(acc) = "; out << 1.+(acc); out << "\n";      // 6 (1 + 5)

        // ---- 5. Nested behavior params / closure capture ----
        // 5. 嵌套行为参数 / 闭包捕获
        -(std::Number total) << 0;
        -(std::Number oc) << std::Number(0);
        std::repeat(std::Number(3)).then([{
            // inner std::repeat captures outer `total`
            // 内层 std::repeat 捕获外层 `total`
            std::repeat(oc).then([{ total << total.+(std::Number(1)); }]);
            oc << oc.+(std::Number(1));
        }]);
        out << "8. nested  = "; out << total; out << "\n";          // 3 (0+1+2)

        // ---- 6. IEEE-754 (never poison) ----
        // 6. IEEE-754（永不毒水）
        -(std::Number z) << 0;
        out << "9. 1/0     = "; out << 1./(z); out << "\n";         // Infinity
        out << "10. 0/0    = "; out << z./(z); out << "\n";         // NaN

        // ---- 7. Tuple destructuring with placeholder `_` ----
        // 7. 占位符 `_` 元组解构
        -(std::Tuple pair) << (100, 200);
        -(std::Number fst, _) << pair;
        out << "11. fst    = "; out << fst; out << "\n";            // 100

        // ---- 8. assert::Checker on a rebind ----
        // 8. assert::Checker 检查重绑
        -(assert::Checker chk);
        -(Counter c);
        out << "12. before  = "; out << chk.has_changed(c); out << "\n"; // false
        c:@inc[() -> () { value << value.+(50); }];
        out << "13. after   = "; out << chk.has_changed(c); out << "\n"; // true
        c.inc();
        out << "14. c.get() = "; out << c.get(); out << "\n";            // 50

        // ---- 9. self keyword + empty method + value-first declaration ----
        // 9. self 关键字 + 空方法 + 值优先声明
        -(std::Number(7) frozen);
        -(Box box);
        out << "15. box.twice() = "; out << box.twice(); out << "\n"; // 14
        out << "16. box.peek()  = "; out << box.peek();   out << "\n"; // 7 (self access)

        // ---- 10. Member access + instantiation expression as a value ----
        // 10. 成员访问 + 实例化表达式作为值
        -(Pair pr); pr.a << 3; pr.b << 7;
        out << "17. pr.get_second() = "; out << pr.get_second(); out << "\n"; // 7
    }];
}

$Counter {
    -(std::Number value);
    @get[() ~> (result) { result << value; }];
    @inc[() -> () { value << value.+(1); }];
}

$Box {
    -(std::Number(7) inner);
    @twice[() -> (result) { result << self.inner.+(self.inner); }];
    @peek[() ~> (result) { result << self.inner; }];   // self access
    @touch[() -> () {}];                            // empty method body
}

// A tiny pair with a `get_second` accessor, used by test 17.
// 带 get_second 访问器的小类，供测试 17 使用。
$Pair {
    -(std::Number a);
    -(std::Number b);
    @get_second[() ~> (result) { result << b; }];
}
