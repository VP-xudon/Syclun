&io;
&maths;
&hash;
&system;
&re;
&async;
&assert;
$Program {
    @::[() -> () {
        io::out << "===== maths =====\n";
        io::out << "clamp(5,0,3) = "; io::out << maths::math.clamp(5.0, 0.0, 3.0); io::out << "\n";          // 3
        io::out << "lerp(0,10,0.5) = "; io::out << maths::math.lerp(0.0, 10.0, 0.5); io::out << "\n";        // 5
        io::out << "sign(-3) = "; io::out << maths::math.sign(-3.0); io::out << "\n";                         // -1
        io::out << "gcd(12,18) = "; io::out << maths::math.gcd(12.0, 18.0); io::out << "\n";                  // 6
        io::out << "lcm(4,6) = "; io::out << maths::math.lcm(4.0, 6.0); io::out << "\n";                     // 12
        io::out << "factorial(5) = "; io::out << maths::math.factorial(5.0); io::out << "\n";                 // 120
        io::out << "comb(5,2) = "; io::out << maths::math.comb(5.0, 2.0); io::out << "\n";                   // 10
        io::out << "is_nan(sqrt(-1)) = "; io::out << maths::math.is_nan(maths::math.sqrt(-1.0)); io::out << "\n";  // true
        io::out << "is_finite(1.0) = "; io::out << maths::math.is_finite(1.0); io::out << "\n";               // true
        io::out << "degrees(pi) = "; io::out << maths::math.degrees(maths::math.pi()); io::out << "\n";       // 180
        io::out << "radians(180) = "; io::out << maths::math.radians(180.0); io::out << "\n";                 // ~pi
        // choice / shuffle (random) — just exercise them
        -(std::Array arr);
        arr.push_back(-(std::Number n) << 1);
        arr.push_back(-(std::Number n) << 2);
        arr.push_back(-(std::Number n) << 3);
        io::out << "choice = "; io::out << maths::math.choice(arr); io::out << "\n";
        io::out << "shuffle = "; io::out << maths::math.shuffle(arr); io::out << "\n";

        io::out << "===== hash =====\n";
        -(hash::Hash h);
        io::out << "sha256(abc) = "; io::out << h.sha256("abc"); io::out << "\n";   // ba7816bf...0015ad
        io::out << "sha1(abc) = "; io::out << h.sha1("abc"); io::out << "\n";       // a9993e36...0d89d
        io::out << "sha512(abc) = "; io::out << h.sha512("abc"); io::out << "\n";
        io::out << "md5(abc) = "; io::out << h.md5("abc"); io::out << "\n";          // 900150983cd24fb0d6963f7d28e17f72
        io::out << "blake2b(abc) len = "; io::out << h.blake2b("abc").length(); io::out << "\n";  // 128 hex
        io::out << "crc32(abc) = "; io::out << h.crc32("abc"); io::out << "\n";
        io::out << "fnv1a(abc) = "; io::out << h.fnv1a("abc"); io::out << "\n";
        io::out << "hmac(sha256,'key','msg') = "; io::out << h.hmac("sha256", "key", "msg"); io::out << "\n";
        io::out << "constant_time_equal('a','a') = "; io::out << h.constant_time_equal("a", "a"); io::out << "\n";  // true
        io::out << "pbkdf2 len = "; io::out << h.pbkdf2("pw", "salt", 1000.0, 32.0).length(); io::out << "\n";  // 64 hex
        io::out << "uuid_v4 = "; io::out << h.uuid_v4(); io::out << "\n";

        io::out << "===== system =====\n";
        -(system::System sys);
        io::out << "os_name = "; io::out << sys.os_name(); io::out << "\n";
        io::out << "arch = "; io::out << sys.arch(); io::out << "\n";
        io::out << "monotonic = "; io::out << sys.monotonic(); io::out << "\n";
        io::out << "environ size = "; io::out << sys.environ().size(); io::out << "\n";
        io::out << "argv size = "; io::out << sys.argv().size(); io::out << "\n";
        sys.setenv("SMOKE_TEST", "1");
        io::out << "getenv(SMOKE_TEST) = "; io::out << sys.getenv("SMOKE_TEST"); io::out << "\n";  // 1
        sys.unsetenv("SMOKE_TEST");

        io::out << "===== re =====\n";
        -(re::Re r);
        io::out << "escape('a.b') = "; io::out << r.escape("a.b"); io::out << "\n";   // a\.b
        -(re::Match m) << r.match("(a)(b)", "ab");
        io::out << "match.matched = "; io::out << m.matched; io::out << "\n";          // true
        io::out << "match.text = "; io::out << m.text; io::out << "\n";                // ab
        io::out << "match.groups = "; io::out << m.groups; io::out << "\n";            // [a,b]
        io::out << "findall('(.)','abc') = "; io::out << r.findall("(.)", "abc"); io::out << "\n";  // [a,b,c]
        io::out << "replace = "; io::out << r.replace("(.)", "abc", "X"); io::out << "\n";          // XXX
        io::out << "replace_fn = "; io::out << r.replace_fn("(.)", "abc",
            [(mt) ~> (x) { x << mt.text; }]); io::out << "\n";                  // abc

        io::out << "===== async =====\n";
        -(async::Reactor r2);
        -(async::Task t) << r2.spawn([() ~> (x) { x << 7; }]);
        io::out << "spawn done? "; io::out << t.is_done(); io::out << "\n";            // likely false
        -(std::Tuple ta) << t.await();
        io::out << "spawn value = "; io::out << ta.get(1).get(0); io::out << "\n";     // 7
        io::out << "task state = "; io::out << t.state(); io::out << "\n";             // done
        // await_all
        -(std::Array tasks);
        tasks.push_back(r2.spawn([() ~> (x) { x << 1; }]));
        tasks.push_back(r2.spawn([() ~> (x) { x << 2; }]));
        -(std::Tuple all) << r2.await_all(tasks);
        io::out << "await_all size = "; io::out << all.size(); io::out << "\n";        // 2
        io::out << "await_all[0] val = "; io::out << all.get(0).get(1).get(0); io::out << "\n";  // 1
        // race
        -(std::Array tasks2);
        tasks2.push_back(r2.spawn([() ~> (x) { x << 10; }]));
        tasks2.push_back(r2.spawn([() ~> (x) { x << 20; }]));
        -(std::Tuple rac) << r2.race(tasks2);
        io::out << "race status = "; io::out << rac.get(0); io::out << "\n";           // ok
        io::out << "race val = "; io::out << rac.get(1).get(0); io::out << "\n";       // 10 or 20
        // all_settled
        -(std::Array tasks3);
        tasks3.push_back(r2.spawn([() ~> (x) { x << 100; }]));
        tasks3.push_back(r2.spawn([() ~> (x) { x << 200; }]));
        -(std::Tuple as) << r2.all_settled(tasks3);
        io::out << "all_settled size = "; io::out << as.size(); io::out << "\n";       // 2

        io::out << "===== assert =====\n";
        -(assert::Assert a);
        io::out << "equal(1,1) = "; io::out << a.equal(-(std::Number n) << 1, -(std::Number n) << 1); io::out << "\n";   // true
        io::out << "is_true(true) = "; io::out << a.is_true(-(std::Boolean b) << true); io::out << "\n";                  // true
        io::out << "near(1.0,1.01,0.1) = "; io::out << a.near(1.0, 1.01, 0.1); io::out << "\n";                        // true
        -(assert::Suite s) << a.suite("demo");
        a.test(s, "adds", [() ~> () { -(std::Number x) << 1; -(std::Number y) << 2; }]);
        a.test(s, "always", [() ~> () { }]);
        -(std::Array results) << a.run(s);
        io::out << "suite results size = "; io::out << results.size(); io::out << "\n";   // 2
        io::out << "TAP:\n"; io::out << a.tap(s); io::out << "\n";
        io::out << "JSON: "; io::out << a.json(s); io::out << "\n";
    }];
}
